{
  "name": "EPI em Dia - Controle de EPIs",
  "short_name": "EPI em Dia",
  "description": "Estoque e entregas de EPIs por gestor, funciona sem internet.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1d1f22",
  "theme_color": "#1d1f22",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./receber",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "arquivo",
          "accept": [
            "application/json",
            ".json",
            "application/octet-stream",
            "text/plain"
          ]
        }
      ]
    }
  },
  "id": "./"
}